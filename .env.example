# Copy this file to .env and adjust values as needed.
# .env is gitignored; this file is safe to commit.

# Path to the universe JSON file (inside the container when using Docker).
ONTO_DATA_FILE=/app/data/locations.json

# Location ID the app starts at on first launch.
ONTO_START_LOCATION=home

# Game mode: a spending budget and a reach-the-target-and-return-home objective.
# On by default; set to 0/false/off to explore with unlimited spending and no
# objective.
ONTO_GAME=1

# Starting budget when game mode is on. A positive value overrides the default
# pool (1000); leave unset to use the default.
# ONTO_BUDGET=1000
