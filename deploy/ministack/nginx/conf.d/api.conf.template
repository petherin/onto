# Committed reference for the git-ignored api.conf.
#
# The real api.conf is generated by shim.sh (Terraform local env) on every
# `terraform apply`: MiniStack's ALB answers only to its own freshly-generated
# *.elb.amazonaws.com DNS name, which changes each run, so the file is rewritten
# and reloaded rather than committed (that churn is why it's git-ignored). nginx
# loads only conf.d/*.conf, so this .template file is never served — it just
# documents the shape the shim produces. onto.conf (the static SPA route) is
# committed normally.
#
# ALB_DNS below is a placeholder; the shim substitutes this run's actual value.
server {
    listen 80;
    server_name api.onto.world;
    location / {
        proxy_pass http://ministack:4566;
        proxy_set_header Host ALB_DNS_PLACEHOLDER.eu-west-1.elb.amazonaws.com;
    }
}
