# Copy this file to .env and adjust values as needed.
# .env is gitignored; this file is safe to commit.

# Path to the universe JSON file (inside the container when using Docker).
ONTO_DATA_FILE=/app/data/locations.json

# Location ID the app starts at on first launch.
ONTO_START_LOCATION=home

# Game mode: a spending budget and a reach-the-target-and-return-home objective.
# On by default; set to 0/false/off to explore with unlimited spending and no
# objective.
ONTO_GAME=1

# Starting budget when game mode is on. A positive value overrides the default
# pool (1000); leave unset to use the default.
# ONTO_BUDGET=1000

# --- Quests (game mode only) ---
# When game mode is off, none of the following is read and no quest is built.
#
# Precedence: ONTO_QUEST (fixed chain) > ONTO_OBJECTIVES (random pool) > built-in
# default chain.

# Fixed quest chain (optional): an ordered, comma-separated list of Onto
# Addresses. When set, this exact chain is used and ONTO_OBJECTIVES is ignored.
# Reach each waypoint in order, then return home to win.
# ONTO_QUEST=onto://Origin.Classical/Origin/Prime/Q2/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/sim:1@Human

# Objective pool (optional): a comma-separated list of candidate Onto Addresses.
# When ONTO_QUEST is unset, the app builds a random quest of 2-4 distinct
# objectives from this pool on startup. Roll a fresh quest at any time with the
# 'quest' command (CLI/TUI) or the "new quest" button (web). The first group of
# addresses each change home on a single reality axis (quantum, timeline,
# simulation, consensus, bubble universe, mathematical structure, or observer);
# the group after them are harder objectives that change several axes at once (or
# go deeper on one), so reaching each demands a sequence of different transition
# commands rather than a single shift.
ONTO_OBJECTIVES=onto://Origin.Classical/Origin/Prime/Q1/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Human,onto://Origin.Classical/Origin/Prime/Q2/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Human,onto://Origin.Classical/Origin/T1/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Human,onto://Origin.Classical/Origin/T2/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/sim:1@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/sim:2@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/cons:1@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/cons:2@Human,onto://Origin.Classical/U1/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Human,onto://Origin.M1/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Machine,onto://Origin.Classical/Origin/Prime/Q3/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home@Human,onto://Origin.Classical/Origin/Prime/Q2/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/sim:1@Human,onto://Origin.Classical/Origin/Prime/Q3/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/cons:2@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/sim:3@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/sim:2/cons:2@Human,onto://Origin.Classical/Origin/Prime/Q0/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/sim:2@Machine,onto://Origin.Classical/Origin/Prime/Q3/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/sim:2/cons:1@Human,onto://Origin.Classical/Origin/Prime/Q2/Milky_Way/Solar_System/Earth/United_Kingdom/Yorkshire/Leeds/Home/cons:2@Machine
